{
  "name": "byjg/micro-orm",
  "description": "A micro framework for create a very simple decoupled ORM. This library intended to be very small and very simple to use",
  "autoload": {
    "psr-4": {
      "ByJG\\MicroOrm\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "prefer-stable": true,
  "minimum-stability": "dev",
  "require": {
    "php": ">=8.3 <8.7",
    "ext-json": "*",
    "ext-pdo": "*",
    "byjg/anydataset-db": "^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5",
    "byjg/cache-engine": "^7.0"
  },
  "suggest": {
    "ext-curl": "*",
    "ext-pdo_mysql": "*"
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "psalm": [
      "@composer --working-dir=tools/psalm update --no-interaction",
      "tools/psalm/vendor/bin/psalm --threads=1"
    ]
  },
  "license": "MIT"
}
